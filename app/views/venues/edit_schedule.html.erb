<h3>Venue schedule</h3>

<%= form_with(url: add_schedule_venue_path(@venue), method: :patch, remote: true, html: { class: "form-inline" }) do |f| %>
<div class="form-group mb-2">
  <%= label_tag :schedule_start_time, "Start Time", class: "mr-2" %>
  <%= datetime_field_tag :schedule_start_time, Time.zone.now.strftime("%Y-%m-%dT%H:%M"), class: "form-control mr-3" %>
</div>
<div class="form-group mb-2">
  <%= label_tag :schedule_end_time, "End Time", class: "mr-2" %>
  <%= datetime_field_tag :schedule_end_time, (Time.zone.now + 8.hours).strftime("%Y-%m-%dT%H:%M"), class: "form-control mr-3" %>
</div>
<%= submit_tag "Add Schedule", class: "btn btn-primary mb-2" %>
<% end %>
<%= link_to "Reset Schedule", reset_schedule_venue_path(@venue), method: :patch, data: { turbo_method: :patch, turbo_confirm: "Are you sure?" }, class: "btn btn-secondary mb-2" %>

<div id="calendar">
  <%= week_calendar(events: @events, start_date: Date.today, partial: "calendars/week_hourly") do |event |%>
  <% end %>
</div>