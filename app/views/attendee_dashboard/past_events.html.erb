<h2 class="mb-4">Past Events</h2>

<% if @past_events.any? %>
  <div class="container">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @past_events.each do |event| %>
        <div class="col">
          <div class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title text-warning fw-semibold"><%= event.name %></h5>
                <p class="card-subtitle text-muted mb-2">
                  <%= event.start_time.strftime("%B %d, %Y %I:%M %p") %> -<br>
                  <%= event.end_time.strftime("%B %d, %Y %I:%M %p") %>
                </p>
              </div>

              <div class="mt-3">
                <%= link_to "View event details", event_path(event), class: "btn btn-outline-primary btn-sm w-100 mb-2" %>

                <% existing_rating = event.ratings.find_by(attendee: current_user) %>
                <% if existing_rating %>
                  <p class="text-center text-warning fw-bold mb-0">
                    You rated this event: <%= existing_rating.rating %>/5
                  </p>
                <% else %>
                  <%= form_with url: rate_event_path(event), method: :post, local: true do %>
                    <div class="input-group input-group-sm">
                      <label class="input-group-text">Rating</label>
                      <%= number_field_tag :rating, nil, in: 1..5, step: 1, required: true, class: "form-control" %>
                      <button class="btn btn-success" type="submit">Submit</button>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <p class="text-muted">You haven't attended any events yet.</p>
<% end %>
